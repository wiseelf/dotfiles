{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "skillOverrides": {
    "code-review": "off"
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/claude-state.sh working" }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/claude-state.sh waiting" }]
      }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/claude-state.sh working" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/claude-state.sh done" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.config/tmux/claude-state.sh" }] }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "antonbabenko": {
      "source": {
        "source": "github",
        "repo": "antonbabenko/agent-plugins"
      },
      "autoUpdate": false
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": false
    }
  },
  "outputStyle": "STE100",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoCompactEnabled": true
}
